# Скопируй в .env и заполни своими значениями

# Строка подключения к PostgreSQL (получишь у хостинга: Render / Neon / Supabase / Railway)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edunity

# Секрет для подписи JWT — сгенерируй случайную строку (например: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string

# На сколько выдаём сессию
JWT_EXPIRES_IN=7d

# Порт, на котором слушает сервер
PORT=4000

# Домен фронтенда, которому разрешаем ходить в API — используется только если
# CORS_STRICT=1 (см. ниже). В разработке можно не трогать.
FRONTEND_ORIGIN=http://localhost:5500

# По умолчанию (CORS_STRICT не задан) сервер разрешает запросы с ЛЮБОГО адреса —
# удобно для разработки, когда Live Server открывается то на localhost, то на
# локальном IP. Перед деплоем в продакшн поставь CORS_STRICT=1, тогда будет
# работать только FRONTEND_ORIGIN выше.
CORS_STRICT=0

# SSL для базы. Локальный PostgreSQL SSL НЕ поддерживает — оставь 0.
# Для облачной базы (Neon / Supabase / Render) поставь 1.
DB_SSL=0

# ==========================================================
# ХРАНИЛИЩЕ ФАЙЛОВ
# ==========================================================
# local — файлы в папке backend/uploads (для работы на своём компьютере)
# s3    — файлы в Cloudflare R2 (обязательно для хостинга: там папка
#         очищается при каждом передеплое, и загруженные видео пропадут)
STORAGE_DRIVER=local

# Заполняется только при STORAGE_DRIVER=s3 (данные берутся в панели R2)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=edunity
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxx.r2.dev
# S3_REGION=auto

# ==========================================================
# ПОЧТА (подтверждение адреса и восстановление пароля)
# ==========================================================
# Если не заполнить — письма не отправляются, а ссылки печатаются
# в консоль сервера. Для разработки этого достаточно.
#
# Пример для Brevo (бесплатно 300 писем в день):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=твой_логин
# SMTP_PASS=твой_smtp_ключ
# MAIL_FROM=EDUNITY <no-reply@твойдомен.ge>
#
# Для Gmail нужен «пароль приложения», обычный пароль не подойдёт:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=твоя@gmail.com
# SMTP_PASS=пароль_приложения
